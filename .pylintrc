[MESSAGES CONTROL]
# These are too noisy in our humble scripts
disable=C0103,    # Disable 'Constant name "args" doesn't conform to UPPER_CASE naming style (invalid-name)'
      broad-exception-caught,          # Catching Exception at top-level loops/handlers is deliberate
      logging-fstring-interpolation    # f-string logging is intentional in this sample for readability

[FORMAT]

# Increase default line length
max-line-length=120

[BASIC]

# Allow 'e' as a good variable name (for exceptions)
good-names=i,
           j,
           k,
           ex,
           Run,
           _,
           e
