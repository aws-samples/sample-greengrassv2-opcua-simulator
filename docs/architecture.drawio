          <mxGeometry x="970" y="560" width="740" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="collector" value="&lt;b&gt;OPC UA collector&lt;/b&gt;&lt;br&gt;aws.iot.SiteWiseEdgeCollectorOpcua&lt;br&gt;source opcua-sim, prefix /opcua-sim" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=6;spacingRight=4;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1">
