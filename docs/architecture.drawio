        </mxCell>
        <mxCell id="simgroup" value="com.amazon.samples.OpcUaDataSim component&lt;br&gt;(recipe runs docker compose up)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;fontSize=12;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=1;spacingLeft=80;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;Docker container opcua-data-sim&lt;/b&gt;&lt;br&gt;OPC UA server opc.tcp://0.0.0.0:4840/simulator/ &amp;mdash; port 4840 published&lt;br&gt;/app/config.json: Motor01 &amp;rarr; Temperature, Current, Vibration, Running&lt;br&gt;non-root UID 1000 &amp;middot; read-only rootfs &amp;middot; cap_drop ALL &amp;middot; no-new-privileges&lt;br&gt;IPC client with the SVCUID token &amp;mdash; no device certificate in the container" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=6;spacingRight=4;fillColor=#E3F2FD;strokeColor=#1F5AA6;" vertex="1" parent="1">
          <mxGeometry x="120" y="600" width="420" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="nucleus" value="&lt;b&gt;Greengrass Nucleus&lt;/b&gt;&lt;br&gt;IPC MQTT proxy (ipc.socket)&lt;br&gt;owns the IoT Core connection&lt;br&gt;+ Docker application manager,&lt;br&gt;&amp;nbsp;&amp;nbsp; Token exchange service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=6;spacingRight=4;fillColor=#E8F5E9;strokeColor=#7AA116;" vertex="1" parent="1">
